aws_region   = "us-east-1"
project_name = "enterprise-mlops-platform"
environment  = "dev"
owner        = "kapil-kumaria"

vpc_cidr = "10.80.0.0/16"

availability_zones = [
  "us-east-1a",
  "us-east-1b",
]

public_subnet_cidrs = [
  "10.80.0.0/24",
  "10.80.1.0/24",
]

private_subnet_cidrs = [
  "10.80.10.0/24",
  "10.80.11.0/24",
]

ecr_image_retention_count = 10
force_destroy_storage     = true

kubernetes_version = "1.36"

cluster_endpoint_public_access_cidrs = [
  "203.0.113.10/32",
]

eks_node_instance_types = [
  "t3.medium",
]

eks_node_desired_size = 2
eks_node_min_size     = 1
eks_node_max_size     = 3
